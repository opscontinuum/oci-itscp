# dr-resources.env.example
#
# Copy to terraform/dr-resources.env and populate from your Terraform outputs.
# The real file is gitignored — it contains OCIDs, not secrets, but there is no
# reason to publish your resource inventory.
#
#   cp terraform/dr-resources.env.example terraform/dr-resources.env
#   terraform output -json | jq -r '...'   # or populate by hand

# --- Regions ----------------------------------------------------------------
PRIMARY_REGION="us-ashburn-1"
DR_REGION="us-phoenix-1"
DR_COMPARTMENT_OCID="ocid1.compartment.oc1..REPLACE"

# --- ExaDB-D ----------------------------------------------------------------
DR_VMCLUSTER_OCID="ocid1.cloudvmcluster.oc1.phx.REPLACE"
# OCPU floor for the standby cluster (total across VMs). Setting a VM cluster to 0 OCPU
# shuts the cluster down, which stops Oracle Data Guard redo apply and silently voids the
# RPO; Oracle's minimum is 2 OCPU per VM (8 ECPU per VM on X11M). set-dr-posture.sh and
# scale-exadata-ocpu.sh refuse values below the floor.
DR_OCPU_FLOOR="4"
DR_OCPU_MIN_PER_VM="2"
DR_OCPU_PRODUCTION="32"

# --- Oracle Data Guard ------------------------------------------------------
DG_CONNECT="sys/REPLACE@EBSPROD_IAD as sysdba"
DG_PRIMARY="EBSPROD_IAD"
DG_STANDBY_LOCAL="EBSPROD_IAD2"
DG_STANDBY_REMOTE="EBSPROD_PHX"

# --- Windows compute (space-separated OCIDs) --------------------------------
# Physical instance names are unique per region and AD (IAD-EBSWEB01 / PHX-EBSWEB01 ...);
# EBS itself is configured with logical host names (docs/01 §5.1).
DR_APP_INSTANCE_OCIDS="ocid1.instance.oc1.phx.WEB01 ocid1.instance.oc1.phx.WEB02 ocid1.instance.oc1.phx.CM01 ocid1.instance.oc1.phx.CM02 ocid1.instance.oc1.phx.BI01"
# Never stopped by the WARM posture: the BI tier reads the Active Data Guard standby every day.
DR_ALWAYS_ON_INSTANCE_OCIDS="ocid1.instance.oc1.phx.BI01"
DR_DRILL_INSTANCE_OCIDS="ocid1.instance.oc1.phx.DRILLWEB01 ocid1.instance.oc1.phx.DRILLCM01"

# --- OCI Block Volume: Volume Group Replication -----------------------------
DR_VOLUME_GROUP_REPLICA_OCIDS="ocid1.volumegroupreplica.oc1.phx.REPLACE"

# --- OCI File Storage: File System Replication ------------------------------
DR_FSS_REPLICATION_OCIDS="ocid1.replication.oc1.phx.REPLACE"

# --- OCI Object Storage: Replication Policy (bucket:policy-id pairs) --------
DR_OS_NAMESPACE="REPLACE"
DR_BUCKET_POLICIES="ebs-interfaces:REPLACE-policy-id ebs-archive:REPLACE-policy-id"

# --- Oracle Database Autonomous Recovery Service ----------------------------
DR_PROTECTED_DB_OCIDS="ocid1.protecteddatabase.oc1.iad.REPLACE"

# --- Load balancer ----------------------------------------------------------
DR_LB_OCID="ocid1.loadbalancer.oc1.phx.REPLACE"
DR_LB_BACKENDSET="ebs-web-backendset"

# --- Drill isolation (consumed by Start-EBSAppTier.ps1 -DrillMode) ----------
DR_DRILL_SINK_HOST="drill-sink.internal.example"
DR_DRILL_LB_REGISTERED="false"

# --- Primary-side resources (used by scale-exadata-ocpu.sh, steer-traffic.sh,
#     detect-drift.sh, decommission-dr.sh) ------------------------------------
PRIMARY_COMPARTMENT_OCID="ocid1.compartment.oc1..REPLACE"
PRIMARY_VMCLUSTER_OCID="ocid1.cloudvmcluster.oc1.iad.REPLACE"
PRIMARY_VMCLUSTER_NODE_COUNT="2"
PRIMARY_OCPU_FLOOR="8"
PRIMARY_OCPU_PRODUCTION="32"
PRIMARY_LB_OCID="ocid1.loadbalancer.oc1.iad.REPLACE"
PRIMARY_LB_BACKENDSET="ebs-web-backendset"
PRIMARY_DATABASE_OCID="ocid1.database.oc1.iad.REPLACE"
PRIMARY_VOLUME_GROUP_OCIDS="ocid1.volumegroup.oc1.iad.REPLACE"
# Node count of the Phoenix VM cluster; scale-exadata-ocpu.sh reads it from the API if unset.
DR_VMCLUSTER_NODE_COUNT="2"
DR_EXA_INFRA_OCID="ocid1.cloudexadatainfrastructure.oc1.phx.REPLACE"
DR_STANDBY_DATABASE_OCID="ocid1.database.oc1.phx.REPLACE"
# Standby-side connect string for forensic capture when the primary is unreachable.
DG_CONNECT_STANDBY="sys/REPLACE@EBSPROD_PHX as sysdba"

# --- OCI Traffic Management (steer-traffic.sh) -----------------------------
DR_STEERING_POLICY_OCID="ocid1.dnspolicy.oc1..REPLACE"
DR_STEERING_ANSWER_IAD="ebs-ashburn-lb"
DR_STEERING_ANSWER_PHX="ebs-phoenix-lb"
DR_HEALTH_CHECK_OCIDS="ocid1.httpmonitor.oc1..REPLACE"

# --- Full Stack DR (decommission-dr.sh) ------------------------------------
DR_FSDR_DRPG_OCIDS="ocid1.drprotectiongroup.oc1.iad.REPLACE ocid1.drprotectiongroup.oc1.phx.REPLACE"
DR_ACTIVATED_VOLUME_GROUP_OCIDS=""
DR_EVIDENCE_ARCHIVE_BUCKET="ebs-dr-evidence-archive"

# --- Drift detection (detect-drift.sh) --------------------------------------
# Same-hostname instance pairs, <ashburn-ocid>:<phoenix-ocid>, space-separated.
DR_NODE_PAIRS="ocid1.instance.oc1.iad.WEB01:ocid1.instance.oc1.phx.WEB01 ocid1.instance.oc1.iad.CM01:ocid1.instance.oc1.phx.CM01"
DR_NSG_PAIRS="ocid1.networksecuritygroup.oc1.iad.REPLACE:ocid1.networksecuritygroup.oc1.phx.REPLACE"
DR_IMAGE_NAME_PREFIX="ebs-apptier-"
# Logical host names as they appear in FND_NODES (not the physical computer names).
DR_EXPECTED_NODES="ebsweb01 ebsweb02 ebscm01 ebscm02 ebsbi01"
APPS_CONNECT="apps/REPLACE@EBSPROD"

# --- RPO attestation (generate-rpo-attestation.sh) --------------------------
# One entry per line: <label>|<tier RPO seconds>|<namespace>|<metric>|<dimension filter>|<compartment>|<region>
# Metric namespaces and names MUST be confirmed against the OCI Monitoring metric
# reference for each service before the first report is trusted.
# Sources: Database Management "oracle_oci_database" namespace (requires Diagnostics & Management
# enabled on the database), Block Volume "oci_blockstore" (per volume replica, not per group),
# File Storage "oci_filestorage". Object Storage publishes no replication metric; its status
# comes from the replication policy resource, which check-replication-health.sh reads.
# Tier 0 cross-region RPO is < 30 s (docs/02 §2); the alarm thresholds in docs/04 §2 are
# warning levels, not the RPO. Attest against the RPO.
DR_RPO_METRICS='Data Guard apply lag PHX|30|oracle_oci_database|ApplyLag|primaryDbUniqueName = "EBSPROD_IAD"|ocid1.compartment.oc1..REPLACE|us-phoenix-1
Data Guard transport lag PHX|30|oracle_oci_database|TransportLag|primaryDbUniqueName = "EBSPROD_IAD"|ocid1.compartment.oc1..REPLACE|us-phoenix-1
Volume replica seconds since last sync|1800|oci_blockstore|VolumeReplicationSecondsSinceLastSync|resourceId = "ocid1.volumereplica.oc1.phx.REPLACE"|ocid1.compartment.oc1..REPLACE|us-phoenix-1
FSS replication recovery point age|3600|oci_filestorage|ReplicationRecoveryPointAge|resourceId = "ocid1.replicationtarget.oc1.phx.REPLACE"|ocid1.compartment.oc1..REPLACE|us-phoenix-1'
